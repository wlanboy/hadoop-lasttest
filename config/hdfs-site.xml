<?xml version="1.0"?>
<configuration>

  <!-- ===== HA-Nameservice (nur Client-relevante Properties) =====
       Server-seitige Properties (name.dir, data.dir, journalnode.edits.dir,
       ha.fencing.*, ha.zookeeper.quorum, automatic-failover, handler.count, ...)
       fehlen hier absichtlich - die braucht nur der Daemon im hadoop-Repo,
       nicht dieser Client. -->
  <property>
    <name>dfs.nameservices</name>
    <value>ns1</value>
  </property>

  <property>
    <name>dfs.ha.namenodes.ns1</name>
    <value>nn1,nn2</value>
  </property>

  <!-- Diese Skripte laufen auf dem Host, nicht im Docker-Netz "hadoop" -
       nn1/nn2 sind dort nicht per Hostname aufloesbar. Stattdessen die von
       docker-compose.yml (hadoop-Repo) auf den Host veroeffentlichten Ports
       verwenden: nn1 RPC 8020->8020, nn2 RPC 8021->8020 (interner Port
       bleibt 8020, nur der Host-Port ist wegen der Kollision mit nn1
       verschoben). -->
  <property>
    <name>dfs.namenode.rpc-address.ns1.nn1</name>
    <value>localhost:8020</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.ns1.nn2</name>
    <value>localhost:8021</value>
  </property>

  <property>
    <name>dfs.namenode.http-address.ns1.nn1</name>
    <value>localhost:9870</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.ns1.nn2</name>
    <value>localhost:9871</value>
  </property>

  <!-- Erkennt automatisch den aktiven NameNode und probiert bei Bedarf den
       anderen durch - der Client braucht dafuer keine ZooKeeper-Verbindung. -->
  <property>
    <name>dfs.client.failover.proxy.provider.ns1</name>
    <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  </property>

  <!-- Default-Werte fuer neu angelegte Dateien - muessen zum Cluster passen,
       damit hdfs dfs -put etc. dieselben Werte wie die Server-Config
       verwenden. -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.blocksize</name>
    <value>16777216</value>
  </property>

  <property>
    <name>dfs.client.retry.policy.enabled</name>
    <value>true</value>
  </property>

  <property>
    <name>dfs.client.block.write.replace-datanode-on-failure.enable</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.client.block.write.replace-datanode-on-failure.policy</name>
    <value>DEFAULT</value>
  </property>

</configuration>
